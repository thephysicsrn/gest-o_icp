rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check auth
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isTeacher() {
      return isAuthenticated() && getUserData().role == 'teacher';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Research Groups
    match /research_groups/{groupId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || (isTeacher() && resource.data.leaderTeacherId == request.auth.uid);
    }

    // Research Lines (Max 5 lines, Max 3 students)
    match /research_lines/{lineId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isTeacher();
    }

    // Meetings & Attendance
    match /meetings_attendance/{meetingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isTeacher();
    }

    // Activities / Tasks
    match /activities/{taskId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin() || isTeacher();
      allow update: if isAuthenticated(); // Alunos podem atualizar status e enviar links
    }

    // Private Room Resources (Strict isolation per line)
    match /line_resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isTeacher();
    }

    // Logbooks (Pre-University standard)
    match /logbooks/{logbookId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == request.resource.data.studentId || isTeacher() || isAdmin());
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.studentId);
    }

    // Photo Records
    match /photo_records/{photoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (request.auth.uid == request.resource.data.studentId || isTeacher() || isAdmin());
    }
  }
}
